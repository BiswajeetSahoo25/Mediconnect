#Server
NODE_ENV=development
PORT=3000

#Database
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/mediconnect"

#Frontend_url
FRONTEND_URL=http://localhost:5173

# Authentication
JWT_ACCESS_SECRET=local_development_only_replace_with_random_32_plus_characters
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=30

GEOAPIFY_API_KEY=local-development-placeholder

# openFDA API (U.S. FDA drug/labeling data)
OPENFDA_API_KEY=


# Replace these local-only placeholders before running seed scripts.
SEED_ADMIN_EMAIL=local-admin@example.invalid
SEED_ADMIN_PASSWORD=replace-with-a-private-local-admin-password
SEED_DOCTOR_PASSWORD=replace-with-a-private-local-doctor-password
